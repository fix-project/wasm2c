;; Subset of floating-point tests from the spec suite excluding tests that require
;; unimplmented features. Export names were modified to become valid C++
;; and tests were modified to include operands as constants rather than params.

;; ------------------------------------------------------------ address.wast
(module
  (memory 1)
  (data (i32.const 0) "\00\00\00\00\00\00\a0\7f\01\00\d0\7f")
  (func (export "_32_good1_0") (result f32) (f32.load offset=0 (i32.const 0)))
  (func (export "_32_good2_0") (result f32) (f32.load align=1 (i32.const 0)))
  (func (export "_32_good3_0") (result f32) (f32.load offset=1 align=1 (i32.const 0)))
  (func (export "_32_good4_0") (result f32) (f32.load offset=2 align=2 (i32.const 0)))
  (func (export "_32_good5_0") (result f32) (f32.load offset=8 align=4 (i32.const 0)))
  (func (export "_32_good1_1") (result f32) (f32.load offset=0 (i32.const 65524)))
  (func (export "_32_good2_1") (result f32) (f32.load align=1 (i32.const 65524)))
  (func (export "_32_good3_1") (result f32) (f32.load offset=1 align=1 (i32.const 65524)))
  (func (export "_32_good4_1") (result f32) (f32.load offset=2 align=2 (i32.const 65524)))
  (func (export "_32_good5_1") (result f32) (f32.load offset=8 align=4 (i32.const 65524)))
  (func (export "_32_good1_2") (result f32) (f32.load offset=0 (i32.const 65525)))
  (func (export "_32_good2_2") (result f32) (f32.load align=1 (i32.const 65525)))
  (func (export "_32_good3_2") (result f32) (f32.load offset=1 align=1 (i32.const 65525)))
  (func (export "_32_good4_2") (result f32) (f32.load offset=2 align=2 (i32.const 65525)))
  (func (export "_32_good5_2") (result f32) (f32.load offset=8 align=4 (i32.const 65525)))
  (func (export "_32_bad_0") (drop (f32.load offset=4294967295 (i32.const 0))))
  (func (export "_32_bad_1") (drop (f32.load offset=4294967295 (i32.const 1))))
)
(assert_return (invoke "_32_good1_0") (f32.const 0.0))
(assert_return (invoke "_32_good2_0") (f32.const 0.0))
(assert_return (invoke "_32_good3_0") (f32.const 0.0))
(assert_return (invoke "_32_good4_0") (f32.const 0.0))
(assert_return (invoke "_32_good5_0") (f32.const nan:0x500001))
(assert_return (invoke "_32_good1_1") (f32.const 0.0))
(assert_return (invoke "_32_good2_1") (f32.const 0.0))
(assert_return (invoke "_32_good3_1") (f32.const 0.0))
(assert_return (invoke "_32_good4_1") (f32.const 0.0))
(assert_return (invoke "_32_good5_1") (f32.const 0.0))
(assert_return (invoke "_32_good1_2") (f32.const 0.0))
(assert_return (invoke "_32_good2_2") (f32.const 0.0))
(assert_return (invoke "_32_good3_2") (f32.const 0.0))
(assert_return (invoke "_32_good4_2") (f32.const 0.0))
(assert_trap (invoke "_32_good5_2") "out of bounds memory access")
(assert_trap (invoke "_32_bad_0") "out of bounds memory access")
(assert_trap (invoke "_32_bad_1") "out of bounds memory access")
(module
  (memory 1)
  (data (i32.const 0) "\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\f4\7f\01\00\00\00\00\00\fc\7f")
