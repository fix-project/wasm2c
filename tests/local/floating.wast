;; ------------------------------------------------------------ func.wast
(module
  (type $sig (func))
  (type $sig-1 (func))
  (type $sig-2 (func (result i32)))
  (type $sig-3 (func (param $x i32)))
  (type $sig-4 (func (param i32 f64 i32) (result i32)))
  (type $forward (func))
  (func (export "f"))
  (func $h (export "g"))
  (func (export "type_use_1") (type $sig-1))
  (func (export "type_use_2") (type $sig-2) (i32.const 0))
  (func (export "type_use_3") (type $sig-3))
  (func (export "type_use_4") (type $sig-4) (i32.const 0))
  (func (export "type_use_5") (type $sig-2) (result i32) (i32.const 0))
  (func (export "empty"))
  (func (export "value_i32") (result i32) (i32.const 77))
  (func (export "value_i64") (result i64) (i64.const 7777))
  (func (export "value_f32") (result f32) (f32.const 77.7))
  (func (export "value_f64") (result f64) (f64.const 77.77))
)
(assert_return (invoke "type_use_1"))
(assert_return (invoke "type_use_2") (i32.const 0))
(assert_return (invoke "type_use_5") (i32.const 0))
(assert_return (invoke "empty"))
(assert_return (invoke "value_i32") (i32.const 77))
(assert_return (invoke "value_i64") (i64.const 7777))
(assert_return (invoke "value_f32") (f32.const 77.7))
(assert_return (invoke "value_f64") (f64.const 77.77))
(module
  (type $sig (func))
  (type $sig-1 (func))
  (type $sig-2 (func (result i32)))
  (type $sig-3 (func (param $x i32)))
  (type $sig-4 (func (param i32 f64 i32) (result i32)))
  (type $forward (func))
  (func (export "type_use_7_0") (result i32) (i32.const 0))
  (func (export "param_first_i32_0") (result i32) (i32.const 2))
  (func (export "param_first_i64_0") (result i64) (i64.const 2))
  (func (export "param_first_f32_0") (result f32) (f32.const 2))
  (func (export "param_first_f64_0") (result f64) (f64.const 2))
  (func (export "param_second_i32_0") (result i32) (i32.const 3))
  (func (export "param_second_i64_0") (result i64) (i64.const 3))
  (func (export "param_second_f32_0") (result f32) (f32.const 3))
  (func (export "param_second_f64_0") (result f64) (f64.const 3))
)
(assert_return (invoke "type_use_7_0") (i32.const 0))
(assert_return (invoke "param_first_i32_0") (i32.const 2))
(assert_return (invoke "param_first_i64_0") (i64.const 2))
(assert_return (invoke "param_first_f32_0") (f32.const 2))
(assert_return (invoke "param_first_f64_0") (f64.const 2))
(assert_return (invoke "param_second_i32_0") (i32.const 3))
(assert_return (invoke "param_second_i64_0") (i64.const 3))
(assert_return (invoke "param_second_f32_0") (f32.const 3))
(assert_return (invoke "param_second_f64_0") (f64.const 3))

