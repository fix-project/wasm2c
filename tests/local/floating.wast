(assert_return (invoke "_64_good5_0") (f64.const nan:0xc000000000001))
(assert_return (invoke "_64_good1_1") (f64.const 0.0))
(assert_return (invoke "_64_good2_1") (f64.const 0.0))
(assert_return (invoke "_64_good3_1") (f64.const 0.0))
(assert_return (invoke "_64_good4_1") (f64.const 0.0))
(assert_return (invoke "_64_good5_1") (f64.const 0.0))
(assert_return (invoke "_64_good1_2") (f64.const 0.0))
(assert_return (invoke "_64_good2_2") (f64.const 0.0))
(assert_return (invoke "_64_good3_2") (f64.const 0.0))
