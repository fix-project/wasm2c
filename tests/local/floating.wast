  (func (export "_64_good5_0") (result f64) (f64.load offset=18 align=8 (i32.const 0)))
  (func (export "_64_good1_1") (result f64) (f64.load offset=0 (i32.const 65510)))
  (func (export "_64_good2_1") (result f64) (f64.load align=1 (i32.const 65510)))
